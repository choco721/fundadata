# Copiar a .env.local y completar con los valores del proyecto.
# NO commitear .env ni .env.local.

# Supabase — Project Settings → API
VITE_SUPABASE_URL=https://<tu-proyecto>.supabase.co
VITE_SUPABASE_ANON_KEY=<tu-anon-key>

# WhatsApp de soporte de la Fundación, formato internacional sin "+".
# Se usa en los botones "Contactar a soporte" del login y de la pantalla
# "Rol Pendiente". Si se deja vacío, esos botones no se muestran.
VITE_SOPORTE_WHATSAPP=5490000000000
